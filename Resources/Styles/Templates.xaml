<?xml version="1.0" encoding="UTF-8" ?>
<!-- Gabarits partagés. Les couleurs des données passent par c:Theme.* (clés de thème), donc suivent le mode sombre. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:c="clr-namespace:BLY.Controls">

    <!-- Ligne de mouvement (tableau de bord, historique, synchro). Le parent doit exposer OpenMovementCommand. -->
    <DataTemplate x:Key="MovementTemplate">
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <Border.GestureRecognizers>
                <TapGestureRecognizer CommandParameter="{Binding .}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMovementCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Tuile}" c:Theme.Back="{Binding TileKey}" VerticalOptions="Start">
                    <c:BlyIcon Source="{Binding Icon}" c:Theme.Tint="{Binding IconKey}" WidthRequest="22" HeightRequest="22" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Title}" Style="{StaticResource LblCorpsGras}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource LblLegende}" MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">
                    <Label Text="{Binding Qty}" Style="{StaticResource LblMonoGras}" c:Theme.Text="{Binding QtyKey}" HorizontalTextAlignment="End" />
                    <Label Text="{Binding Unit}" Style="{StaticResource LblLegende}" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="SectionHeaderTemplate">
        <Label Text="{Binding Title}" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" Margin="0,12,0,8" />
    </DataTemplate>
</ResourceDictionary>
