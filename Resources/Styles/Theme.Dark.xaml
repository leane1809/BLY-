<?xml version="1.0" encoding="UTF-8" ?>
<!-- Généré depuis les variables Figma (collection Sémantique, mode Sombre). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="BLY.Resources.Styles.DarkTheme">

    <Color x:Key="ColorFond">#0B0E13</Color>
    <Color x:Key="ColorSurface">#12161D</Color>
    <Color x:Key="ColorSquelette">#1F2530</Color>
    <Color x:Key="ColorTexte">#ECEEF2</Color>
    <Color x:Key="ColorTexteSecondaire">#BCC3CE</Color>
    <Color x:Key="ColorTexteDiscret">#8E98A8</Color>
    <Color x:Key="ColorBordure">#343C4A</Color>
    <Color x:Key="ColorBordureForte">#4A5465</Color>
    <Color x:Key="ColorMarque">#6E98DC</Color>
    <Color x:Key="ColorMarquePresse">#A3BFEB</Color>
    <Color x:Key="ColorMarqueFond">#0E2957</Color>
    <Color x:Key="ColorSurMarque">#0A1D3D</Color>
    <Color x:Key="ColorAccent">#FFC21F</Color>
    <Color x:Key="ColorAccentPresse">#FFD04D</Color>
    <Color x:Key="ColorSurAccent">#12161D</Color>
    <Color x:Key="ColorDesactiveFond">#1F2530</Color>
    <Color x:Key="ColorDesactiveTexte">#667085</Color>
    <Color x:Key="ColorSucces">#7DC69C</Color>
    <Color x:Key="ColorSuccesFond">#0A321B</Color>
    <Color x:Key="ColorSuccesBord">#7DC69C</Color>
    <Color x:Key="ColorAlerte">#F2AD71</Color>
    <Color x:Key="ColorAlerteFond">#4A2403</Color>
    <Color x:Key="ColorErreur">#E98585</Color>
    <Color x:Key="ColorErreurFond">#450E0E</Color>
    <Color x:Key="ColorErreurBord">#E15757</Color>
    <Color x:Key="ColorInfo">#73BED1</Color>
    <Color x:Key="ColorInfoFond">#042E38</Color>
    <Color x:Key="ColorViolet">#AA96E0</Color>
    <Color x:Key="ColorVioletFond">#231840</Color>
    <Color x:Key="ColorVoile">#B3000000</Color>
    <Color x:Key="ColorCamera">#0B0E13</Color>
    <Color x:Key="ColorSurCamera">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrushFond" Color="{StaticResource ColorFond}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSquelette" Color="{StaticResource ColorSquelette}" />
    <SolidColorBrush x:Key="BrushBordure" Color="{StaticResource ColorBordure}" />
    <SolidColorBrush x:Key="BrushBordureForte" Color="{StaticResource ColorBordureForte}" />
    <SolidColorBrush x:Key="BrushMarque" Color="{StaticResource ColorMarque}" />
    <SolidColorBrush x:Key="BrushMarqueFond" Color="{StaticResource ColorMarqueFond}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushSuccesFond" Color="{StaticResource ColorSuccesFond}" />
    <SolidColorBrush x:Key="BrushSuccesBord" Color="{StaticResource ColorSuccesBord}" />
    <SolidColorBrush x:Key="BrushAlerteFond" Color="{StaticResource ColorAlerteFond}" />
    <SolidColorBrush x:Key="BrushErreurFond" Color="{StaticResource ColorErreurFond}" />
    <SolidColorBrush x:Key="BrushErreurBord" Color="{StaticResource ColorErreurBord}" />
    <SolidColorBrush x:Key="BrushInfoFond" Color="{StaticResource ColorInfoFond}" />
    <SolidColorBrush x:Key="BrushVioletFond" Color="{StaticResource ColorVioletFond}" />
    <SolidColorBrush x:Key="BrushVoile" Color="{StaticResource ColorVoile}" />
    <SolidColorBrush x:Key="BrushCamera" Color="{StaticResource ColorCamera}" />
    <SolidColorBrush x:Key="BrushDesactiveFond" Color="{StaticResource ColorDesactiveFond}" />
    <SolidColorBrush x:Key="BrushAlerte" Color="{StaticResource ColorAlerte}" />
    <SolidColorBrush x:Key="BrushErreur" Color="{StaticResource ColorErreur}" />
    <SolidColorBrush x:Key="BrushSucces" Color="{StaticResource ColorSucces}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}" />
</ResourceDictionary>
