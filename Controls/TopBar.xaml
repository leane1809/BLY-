<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="BLY.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             x:Name="Self">
    <Grid BindingContext="{x:Reference Self}" BackgroundColor="{DynamicResource ColorSurface}"
          ColumnDefinitions="Auto,*,Auto" Padding="8,4" MinimumHeightRequest="60">
        <Grid Grid.Column="0" WidthRequest="48" HeightRequest="48" IsVisible="{Binding ShowBack}"
              SemanticProperties.Description="Retour">
            <c:BlyIcon Source="icon_arrow_left" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Grid.GestureRecognizers>
        </Grid>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="8,0" Spacing="0">
            <Label Text="{Binding Title}" Style="{StaticResource LblTitreBarre}" LineBreakMode="TailTruncation" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource LblLegende}" IsVisible="{Binding HasSubtitle}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
        <Grid Grid.Column="2" WidthRequest="48" HeightRequest="48" IsVisible="{Binding HasRight}">
            <c:BlyIcon Source="{Binding RightIcon}" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRightTapped" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView>
