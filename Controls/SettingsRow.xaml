<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="BLY.Controls.SettingsRow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             x:Name="Self">
    <Grid BindingContext="{x:Reference Self}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12" MinimumHeightRequest="64">
        <Border Style="{StaticResource Tuile}" VerticalOptions="Center">
            <c:BlyIcon Source="{Binding Icon}" WidthRequest="22" HeightRequest="22" Tint="{DynamicResource ColorMarque}" />
        </Border>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
            <Label Text="{Binding Title}" Style="{StaticResource LblCorpsGras}" />
            <Label Text="{Binding Value}" Style="{StaticResource LblLegende}" IsVisible="{Binding HasValue}" />
        </VerticalStackLayout>
        <Switch Grid.Column="2" IsToggled="{Binding IsToggled, Mode=TwoWay}" IsVisible="{Binding ShowSwitch}" VerticalOptions="Center" />
        <c:BlyIcon Grid.Column="2" Source="icon_chevron_right" Tint="{DynamicResource ColorTexteSecondaire}" IsVisible="{Binding ShowChevron}" />
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
