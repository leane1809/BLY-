<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android 8+ (API 26). iOS n'est compilé que depuis un Mac. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>BLY</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>

		<ApplicationTitle>BLY</ApplicationTitle>
		<ApplicationId>com.bly.entrepot</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Release Android : APK léger (écoconception) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidLinkMode>r8</AndroidLinkMode>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône et écran de démarrage -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />

		<!-- 57 icônes vectorielles (jeu unique) + logo : SVG convertis au build -->
		<MauiImage Include="Resources\Images\icon_*.svg" BaseSize="48,48" />
		<MauiImage Include="Resources\Images\logo_mark.svg" BaseSize="128,128" />

		<!-- 2 familles : Atkinson Hyperlegible Next + JetBrains Mono (sous-ensemble latin) -->
		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
       <PackageReference Include="CommunityToolkit.Maui" Version="14.2.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.7.4" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Pin Microsoft.Maui.Controls to a version compatible with CommunityToolkit.Maui -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
	</ItemGroup>

</Project>
