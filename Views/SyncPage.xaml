<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.SyncPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <c:TopBar Title="Synchronisation" Subtitle="{Binding Subtitle}" />
        <VerticalStackLayout Grid.Row="1">
            <c:Banner Kind="error" Icon="icon_cloud_off" Text="{Binding BannerText}" IsVisible="{Binding HasFailed}" />
            <c:Banner Kind="success" Text="Tout est synchronisé." IsVisible="{Binding IsDone}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Label Text="Ces opérations sont enregistrées sur le téléphone. Elles seront envoyées dès que le serveur répondra : rien n'est perdu." Style="{StaticResource LblSecondaire}" FontSize="16" />
                <VerticalStackLayout IsVisible="{Binding HasFailed}" Spacing="10">
                    <Label Text="En attente d'envoi" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ops}" BindableLayout.ItemTemplate="{StaticResource MovementTemplate}" />
                    <c:Banner Kind="info" Icon="icon_refresh_cw" Text="{Binding LastTry}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="3" Style="{StaticResource BarreBas}">
            <VerticalStackLayout Spacing="4">
                <Button Text="Réessayer maintenant" Style="{StaticResource BtnPrimaire}" Command="{Binding RetryCommand}" IsEnabled="{Binding IsRetrying, Converter={StaticResource Not}}" IsVisible="{Binding HasFailed}" />
                <Button Text="Exporter le journal" Style="{StaticResource BtnTexte}" Command="{Binding ExportCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
