<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*">
        <c:TopBar Title="{Binding Title}" Subtitle="{Binding Subtitle}" />
        <c:ScannerView x:Name="Scanner" Grid.Row="1" HasError="{Binding HasError}" />
    </Grid>
</ContentPage>
