<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.LocationCreatePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:TopBar Title="Nouvel emplacement" Subtitle="{Binding ZoneSubtitle}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Zone" Style="{StaticResource LblChamp}" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="56">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <c:BlyIcon Source="icon_layout_grid" WidthRequest="22" HeightRequest="22" Tint="{DynamicResource ColorTexteSecondaire}" />
                            <Picker Grid.Column="1" ItemsSource="{Binding ZoneNames}" SelectedIndex="{Binding ZoneIndex, Mode=TwoWay}" VerticalOptions="Center" />
                            <c:BlyIcon Grid.Column="2" Source="icon_chevron_down" WidthRequest="20" HeightRequest="20" Tint="{DynamicResource ColorTexteSecondaire}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <c:FieldEntry Label="Allée" InputKeyboard="Numeric" MaxLength="2" Text="{Binding Aisle, Mode=TwoWay}" />
                    <c:FieldEntry Grid.Column="1" Label="Rayon" MaxLength="1" Text="{Binding Rack, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <c:FieldEntry Label="Niveau" InputKeyboard="Numeric" MaxLength="1" Text="{Binding Level, Mode=TwoWay}" />
                    <c:FieldEntry Grid.Column="1" Label="Capacité" Text="{Binding Capacity, Mode=TwoWay}" />
                </Grid>
                <c:Banner Kind="info" Icon="icon_layout_grid" Text="{Binding GeneratedCode}" />
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding PrintAfter, Mode=TwoWay}" VerticalOptions="Center" />
                    <Label Text="Imprimer l'étiquette QR après création" Style="{StaticResource LblCorps}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding HeavyOnly, Mode=TwoWay}" VerticalOptions="Center" />
                    <Label Text="Emplacement réservé aux produits lourds" Style="{StaticResource LblCorps}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource BarreBas}">
            <Button Text="Créer l'emplacement" Style="{StaticResource BtnPrimaire}" Command="{Binding CreateCommand}" />
        </Border>
    </Grid>
</ContentPage>
