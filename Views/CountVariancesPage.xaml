<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.CountVariancesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <c:TopBar Title="Écarts du comptage" Subtitle="{Binding Subtitle}" />
        <c:StepperBar Grid.Row="1" Steps="Scanner|Compter|Justifier|Valider" Current="3" />
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16" Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" c:Theme.Stroke="{Binding CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Article}" Style="{StaticResource LblCorpsGras}" />
                                    <Label Grid.Column="1" Text="{Binding Code}" Style="{StaticResource LblMono}" FontSize="14" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout><Label Text="Théorique" Style="{StaticResource LblLegende}" /><Label Text="{Binding Theoretical}" Style="{StaticResource LblMonoGras}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"><Label Text="Compté" Style="{StaticResource LblLegende}" /><Label Text="{Binding Counted}" Style="{StaticResource LblMonoGras}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Écart" Style="{StaticResource LblLegende}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <c:BlyIcon Source="{Binding DeltaIcon}" c:Theme.Tint="{Binding DeltaKey}" WidthRequest="18" HeightRequest="18" />
                                        <Label Text="{Binding DeltaText}" Style="{StaticResource LblMonoGras}" c:Theme.Text="{Binding DeltaKey}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasDelta}">
                                    <Label Text="Motif de l'écart" Style="{StaticResource LblChamp}" />
                                    <Border Style="{StaticResource Card}" Padding="12,0" HeightRequest="52" Background="{DynamicResource BrushSurface}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <c:BlyIcon Source="icon_triangle_alert" WidthRequest="20" HeightRequest="20" Tint="{DynamicResource ColorTexteSecondaire}" />
                                            <Picker Grid.Column="1" Title="Choisir un motif" VerticalOptions="Center"
                                                    ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:CountVariancesViewModel}}, Path=Reasons}"
                                                    SelectedItem="{Binding Reason, Mode=TwoWay}" />
                                            <c:BlyIcon Grid.Column="2" Source="icon_chevron_down" WidthRequest="20" HeightRequest="20" Tint="{DynamicResource ColorTexteSecondaire}" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="3" Style="{StaticResource BarreBas}">
            <Button Text="Envoyer au gérant" Style="{StaticResource BtnPrimaire}" Command="{Binding SendCommand}" />
        </Border>
    </Grid>
</ContentPage>
