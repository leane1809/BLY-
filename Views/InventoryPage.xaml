<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <c:TopBar Title="Inventaire tournant" Subtitle="{Binding Subtitle}" ShowBack="False" RightIcon="icon_calendar" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6">
                                <c:BlyIcon Source="icon_check" WidthRequest="18" HeightRequest="18" Tint="{DynamicResource ColorMarque}" />
                                <Label Text="{Binding ProgressText}" Style="{StaticResource LblCorpsGras}" FontSize="14" TextColor="{DynamicResource ColorMarque}" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="33 %" Style="{StaticResource LblMono}" FontSize="14" />
                        </Grid>
                        <c:ProgressTrack Value="{Binding Progress}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="À compter aujourd'hui — avant 12:00" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Tasks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=CountCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource Tuile}"><c:BlyIcon Source="icon_rows_3" WidthRequest="22" HeightRequest="22" Tint="{DynamicResource ColorMarque}" /></Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Style="{StaticResource LblCorpsGras}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Code}" FontFamily="MonoBold" FontSize="15" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Name}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding Detail}" Style="{StaticResource LblLegende}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource LblLegende}" VerticalOptions="Center" />
                                    <c:BlyIcon Grid.Column="3" Source="icon_chevron_right" Tint="{DynamicResource ColorTexteSecondaire}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Terminés" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" Margin="0,6,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DoneList}" BindableLayout.ItemTemplate="{StaticResource MovementTemplate}" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource BarreBas}" Padding="16,10">
            <Button Text="{Binding CountButton}" Style="{StaticResource BtnPrimaire}" Command="{Binding CountNextCommand}" />
        </Border>
        <c:BlyTabBar Grid.Row="3" Selected="inventory" />
    </Grid>
</ContentPage>
