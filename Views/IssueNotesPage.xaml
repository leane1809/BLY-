<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.IssueNotesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <c:TopBar Title="Bons de sortie" Subtitle="Dépôt Bonabéri · 5 bons ouverts" RightIcon="icon_funnel" />
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,12,16,8">
                <c:Chip Text="À préparer · 4" IsSelected="{Binding IsToPrepare, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="0" />
                <c:Chip Text="En cours · 1" IsSelected="{Binding IsInProgress, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="1" />
                <c:Chip Text="Validés" IsSelected="{Binding IsValidated, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="2" />
            </HorizontalStackLayout>
        </ScrollView>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" Margin="16,0">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Aucun bon dans cette liste." Style="{StaticResource LblSecondaire}" HorizontalTextAlignment="Center" Margin="0,48" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IssueNotesViewModel}}, Path=OpenCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource Tuile}" VerticalOptions="Start">
                                <c:BlyIcon Source="icon_upload" WidthRequest="22" HeightRequest="22" Tint="{DynamicResource ColorMarque}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Style="{StaticResource LblCorpsGras}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Id}" FontFamily="MonoBold" FontSize="15" />
                                            <Span Text="  " />
                                            <Span Text="{Binding Customer}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Detail}" Style="{StaticResource LblLegende}" MaxLines="1" LineBreakMode="TailTruncation" />
                                <c:Banner Compact="True" Kind="{Binding StatusKind}" Icon="{Binding StatusIcon}" Text="{Binding Status}" />
                                <Label Text="{Binding When}" Style="{StaticResource LblMono}" FontSize="14" />
                            </VerticalStackLayout>
                            <c:BlyIcon Grid.Column="2" Source="icon_chevron_right" Tint="{DynamicResource ColorTexteSecondaire}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="3" Style="{StaticResource BarreBas}">
            <Button Text="+ Nouveau bon de sortie" Style="{StaticResource BtnPrimaire}" Command="{Binding NewNoteCommand}" />
        </Border>
    </Grid>
</ContentPage>
