<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.CountValidationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:TopBar Title="Écarts à valider" Subtitle="{Binding Subtitle}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource Card}" Padding="14" c:Theme.Stroke="{Binding CardStroke}">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Article}" Style="{StaticResource LblCorpsGras}" />
                                            <Label Grid.Column="1" Text="{Binding Code}" Style="{StaticResource LblMono}" FontSize="14" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*">
                                <VerticalStackLayout><Label Text="Théorique" Style="{StaticResource LblLegende}" /><Label Text="{Binding Theoretical}" Style="{StaticResource LblMonoGras}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"><Label Text="Compté" Style="{StaticResource LblLegende}" /><Label Text="{Binding Counted}" Style="{StaticResource LblMonoGras}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Écart" Style="{StaticResource LblLegende}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <c:BlyIcon Source="{Binding DeltaIcon}" c:Theme.Tint="{Binding DeltaKey}" WidthRequest="18" HeightRequest="18" />
                                        <Label Text="{Binding DeltaText}" Style="{StaticResource LblMonoGras}" c:Theme.Text="{Binding DeltaKey}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                                    </VerticalStackLayout>
                                </Border>
                                <Label Text="{Binding Reason, StringFormat='Motif : {0}'}" Style="{StaticResource LblSecondaire}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Impact total" Style="{StaticResource LblSecondaire}" /><Label Grid.Column="1" Text="{Binding Impact}" Style="{StaticResource LblMonoGras}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Après validation" Style="{StaticResource LblSecondaire}" /><Label Grid.Column="1" Text="Stock ajusté et emplacements clôturés" Style="{StaticResource LblCorpsGras}" FontSize="14" /></Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource BarreBas}">
            <Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Session.IsManager}">
                    <Button Text="Recompter" Style="{StaticResource BtnSecondaire}" Command="{Binding RecountCommand}" />
                    <Button Grid.Column="1" Text="Valider" Style="{StaticResource BtnPrimaire}" Command="{Binding ValidateCommand}" />
                </Grid>
                <c:Banner Kind="info" Text="Validation réservée au gérant." IsVisible="{Binding Session.IsManager, Converter={StaticResource Not}}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
