<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*">
        <c:TopBar Title="Profil et paramètres" RightIcon="icon_log_out" RightCommand="{Binding LogoutCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26" Background="{DynamicResource BrushMarqueFond}">
                            <Label Text="{Binding Session.Initials}" FontFamily="AtkinsonBold" FontSize="18" TextColor="{DynamicResource ColorMarque}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Session.UserName}" Style="{StaticResource LblSection}" />
                            <Label Text="{Binding ProfileLine}" Style="{StaticResource LblSecondaire}" />
                            <c:Banner Compact="True" Kind="success" Icon="icon_shield_check" Text="Compte vérifié" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Travail" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" Margin="0,10,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <c:SettingsRow Icon="icon_warehouse" Title="Entrepôt actif" Value="{Binding WarehouseText}" Command="{Binding WarehouseCommand}" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <c:SettingsRow Icon="icon_globe" Title="Langue" Value="Français" Command="{Binding LanguageCommand}" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <c:SettingsRow Icon="icon_printer" Title="Imprimante d'étiquettes" Value="Thermique 80 mm · connectée" Command="{Binding PrinterCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Synchronisation et économie de données" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" Margin="0,10,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <c:SettingsRow Icon="icon_refresh_cw" Title="Synchronisation automatique" Value="{Binding LastSyncText}" ShowSwitch="True" IsToggled="{Binding Sync.AutoSync, Mode=TwoWay}" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <c:SettingsRow Icon="icon_wifi_off" Title="Wi-Fi uniquement" Value="Économise votre forfait mobile" ShowSwitch="True" IsToggled="{Binding Sync.WifiOnly, Mode=TwoWay}" />
                        <BoxView Style="{StaticResource Separateur}" />
                        <c:SettingsRow Icon="icon_zap" Title="Mode sombre" Value="Économise la batterie (écrans OLED)" ShowSwitch="True" IsToggled="{Binding DarkMode, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Assistance" Style="{StaticResource LblSecondaire}" FontFamily="AtkinsonSemiBold" Margin="0,10,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <c:SettingsRow Icon="icon_circle_help" Title="Aide et support" Value="Guide d'utilisation" Command="{Binding HelpCommand}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
