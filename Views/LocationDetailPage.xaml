<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="BLY.Views.LocationDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:BLY.Controls"
             xmlns:vm="clr-namespace:BLY.ViewModels">
    <Grid RowDefinitions="Auto,*,Auto">
        <c:TopBar Title="{Binding Code}" Subtitle="Zone A · Allée 03 · Rayon B · Niveau 2" RightIcon="{Binding EditIcon}" RightCommand="{Binding EditCommand}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="10">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" Background="{DynamicResource BrushMarqueFond}" Padding="8,4">
                                <HorizontalStackLayout Spacing="6">
                                    <c:BlyIcon Source="icon_map_pin" WidthRequest="16" HeightRequest="16" Tint="{DynamicResource ColorMarque}" />
                                    <Label Text="{Binding Code}" Style="{StaticResource LblMonoGras}" FontSize="15" TextColor="{DynamicResource ColorMarque}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="Allée 03 · Rayon B · Niv. 2" Style="{StaticResource LblSecondaire}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Ciment CPJ 42,5R — sac 50 kg" Style="{StaticResource LblSection}" />
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="120" Style="{StaticResource LblQuantiteXL}" />
                            <Label Text="sacs · 3 palettes" Style="{StaticResource LblSecondaire}" VerticalOptions="End" Margin="0,0,0,8" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="6">
                            <c:BlyIcon Source="icon_check" WidthRequest="18" HeightRequest="18" Tint="{DynamicResource ColorMarque}" />
                            <Label Text="Occupation : 3 palettes sur 4" Style="{StaticResource LblCorpsGras}" FontSize="14" TextColor="{DynamicResource ColorMarque}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="75 %" Style="{StaticResource LblMono}" FontSize="14" />
                    </Grid>
                    <c:ProgressTrack Value="0.75" />
                </VerticalStackLayout>
                <Label Text="Contenu de l'emplacement" Style="{StaticResource LblSection}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Contents}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource Tuile}"><c:BlyIcon Source="icon_package" WidthRequest="22" HeightRequest="22" Tint="{DynamicResource ColorMarque}" /></Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Article}" Style="{StaticResource LblCorpsGras}" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource LblLegende}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding Qty}" Style="{StaticResource LblMonoGras}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Unit}" Style="{StaticResource LblLegende}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Dernier mouvement" Style="{StaticResource LblSection}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LastMovements}" BindableLayout.ItemTemplate="{StaticResource MovementTemplate}" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource BarreBas}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Étiquette" Style="{StaticResource BtnSecondaire}" Command="{Binding LabelCommand}" />
                <Button Grid.Column="1" Text="Déplacer" Style="{StaticResource BtnPrimaire}" Command="{Binding MoveCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
