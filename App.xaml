<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="BLY.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:styles="clr-namespace:BLY.Resources.Styles"
             xmlns:conv="clr-namespace:BLY.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:InvertBoolConverter x:Key="Not" />
            <conv:HasTextConverter x:Key="HasText" />
            <ResourceDictionary.MergedDictionaries>
                <styles:LightTheme />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
